<Window
    x:Class="Ninja3Assistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="忍3助手">
    <Grid Background="#0C1220" RequestedTheme="Dark" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#111A2A" BorderBrush="#253149" BorderThickness="0,0,1,0">
            <Grid x:Name="Sidebar" Padding="20,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="40" Height="40" Source="Assets/Ninja3Icon.png" Stretch="Uniform"
                           AutomationProperties.Name="忍3助手图标" />
                    <StackPanel x:Name="BrandText" VerticalAlignment="Center">
                        <TextBlock Text="忍3助手" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="MUMU · WINDOWS" FontSize="9" Foreground="#98A6C3" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,40,0,0" Spacing="8">
                    <TextBlock x:Name="NavHeading" Text="工作空间" Foreground="#91A1BC" FontSize="11" Margin="10,0,0,6" />
                    <Button x:Name="TaskNav" Click="TaskNav_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="任务中心" ToolTipService.ToolTip="任务中心"
                            HorizontalContentAlignment="Left" Padding="14,10" Background="#263451">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                            <TextBlock x:Name="TaskNavLabel" Text="任务中心" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Click="SettingsNav_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="设备设置" ToolTipService.ToolTip="设备设置"
                            HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="15" />
                            <TextBlock x:Name="SettingsNavLabel" Text="设备设置" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoNav" Click="VideoNav_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="离线调试" ToolTipService.ToolTip="离线调试"
                            HorizontalContentAlignment="Left" Padding="14,10" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE714;" FontSize="15" />
                            <TextBlock x:Name="VideoNavLabel" Text="离线调试" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SidebarFooter" Grid.Row="2" Text="本地识图 · MuMu" Foreground="#71809B" FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="VideoPage" Visibility="Collapsed" Padding="28,24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="离线视频调试" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock x:Name="VideoFileText" Text="导入战斗录像，无需打开游戏或模拟器。" Foreground="#9EACC5"
                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="VideoImportButton" Content="导入视频" Click="VideoImport_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="VideoCloseButton" Content="关闭视频" Click="VideoClose_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#050810" CornerRadius="10" BorderBrush="#2D3D5B" BorderThickness="1">
                    <Grid>
                        <Image x:Name="VideoFrameImage" Stretch="Uniform" />
                        <TextBlock x:Name="VideoPlaceholder" Text="导入 MP4、MKV、AVI、MOV 或哔哩哔哩 M4S 缓存"
                                   Foreground="#8190AB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="22" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Spacing="5">
                    <Slider x:Name="VideoTimeline" Minimum="0" Maximum="1" StepFrequency="1" SmallChange="1"
                            LargeChange="30" IsEnabled="False" ValueChanged="VideoTimeline_ValueChanged"
                            AutomationProperties.Name="视频时间轴" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="VideoPreviousButton" Content="上一帧" Click="VideoPrevious_Click" IsEnabled="False" />
                            <Button x:Name="VideoPlayButton" Content="播放" Click="VideoPlay_Click" IsEnabled="False" />
                            <Button x:Name="VideoNextButton" Content="下一帧" Click="VideoNext_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="VideoTimeText" Grid.Column="1" Text="00:00.000 / 00:00.000 · 帧 --"
                                   Foreground="#B9C5D9" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <Border Grid.Row="3" Background="#151F31" CornerRadius="10" Padding="15,12">
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="VideoBoardText" Text="板子：等待视频" FontSize="16" FontWeight="SemiBold" Foreground="#CBD2FF" />
                        <TextBlock x:Name="VideoStepText" Text="流程：--" Foreground="#D6DDF0" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="VideoActionText" Text="建议动作：--" Foreground="#9BDCC8" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="VideoStatusText" Text="攻击框、历史轨迹和预测方向显示在画面中。" Foreground="#91A1BC"
                                   FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="4" Text="仅分析录像，不发送点击。拖动后重新同步当前波次；播放速度取决于分析耗时。建议动作不会改变录像中的角色。"
                           Foreground="#7788A5" FontSize="11" TextWrapping="Wrap" />
            </Grid>
            <Grid x:Name="TaskPage">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="TaskToolbar" Background="#172238" BorderBrush="#2D3D5B" BorderThickness="0,0,0,1" Padding="24,14">
                    <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="FleetText" Text="MuMu 多开" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" CornerRadius="12" Background="#263451" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusBadge" Text="●  未运行" Foreground="#B6C3DB" FontSize="12" />
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="InstanceBox" HorizontalAlignment="Stretch" PlaceholderText="请选择 MuMu 实例"
                                          AutomationProperties.Name="任务实例" DisplayMemberPath="DisplayName"
                                          SelectionChanged="Instance_SelectionChanged" />
                                <Button x:Name="RefreshInstancesButton" Grid.Column="1" Content="刷新" Click="Scan_Click" />
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="启动助手后自动打开所选模拟器和游戏，并识别当前场景。"
                                       Foreground="#D6DDF0" TextWrapping="Wrap" MaxLines="3" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button x:Name="StartButton" Content="启动" AutomationProperties.Name="启动所选实例"
                                        Style="{StaticResource AccentButtonStyle}" Click="Start_Click" Padding="15,8" />
                                <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" Padding="15,8" />
                                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Padding="15,8" />
                            </StackPanel>
                        </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TaskContent" Padding="34,30,34,30" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="5">
                            <TextBlock Text="任务中心" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="以下配置与运行记录对应当前所选实例。" Foreground="#9EACC5" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="限时活动" FontSize="21" FontWeight="SemiBold" />
                            <SelectorBar x:Name="ActivityTabs" AutomationProperties.Name="限时活动">
                                <SelectorBarItem x:Name="IntelligenceTab" Text="情报模拟战" />
                                <SelectorBarItem x:Name="XumiTab" Text="须弥幻境" />
                            </SelectorBar>
                            <Grid>
                                <StackPanel x:Name="IntelligenceOptions" Spacing="10">
                                    <ToggleSwitch x:Name="ActivityEnabledSwitch" AutomationProperties.Name="启用情报模拟战"
                                                  OffContent="关闭" OnContent="开启" Toggled="ActivityEnabled_Toggled" />
                                    <ComboBox x:Name="ActivityModeBox" Header="任务结束方式" SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="完成日常后停止" Tag="daily" />
                                        <ComboBoxItem Content="持续对战" Tag="continuous" />
                                    </ComboBox>
                                    <TextBlock Text="自动购牌、对战、结算并领取三项日常奖励。" Foreground="#B9C5D9" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="XumiOptions" Spacing="10" Visibility="Collapsed">
                                    <ToggleSwitch x:Name="XumiEnabledSwitch" AutomationProperties.Name="启用须弥幻境"
                                                  OffContent="关闭" OnContent="开启" />
                                    <TextBlock Text="先手动配好方寸和大千的两支队伍，并为大千装备武器。助手从当前开放的第一重或第二重开战，结算后复查日常奖励。" Foreground="#B9C5D9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="可同时开启多个活动，助手按计划依次执行。"
                                       Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="周末活动" FontSize="21" FontWeight="SemiBold" />
                            <SelectorBar x:Name="WeekendTabs" AutomationProperties.Name="周末活动">
                                <SelectorBarItem x:Name="MultiplayerTab" Text="多人竞速" />
                                <SelectorBarItem x:Name="SameScreenTab" Text="同屏竞速" />
                            </SelectorBar>
                            <Grid>
                                <StackPanel x:Name="MultiplayerOptions" Spacing="10">
                                    <ToggleSwitch x:Name="WeekendEnabledSwitch" AutomationProperties.Name="启用多人竞速"
                                                  OffContent="关闭" OnContent="开启" Toggled="WeekendEnabled_Toggled" />
                                    <ComboBox x:Name="WeekendModeBox" Header="任务结束方式" IsEnabled="False" />
                                    <TextBlock Text="按当前多人竞速页面识别介绍页、排行榜主页与五项日常；死亡出现接力弹框时跳过不接，赛后结算、领取奖励和障碍动作均复核画面。"
                                               Foreground="#B9C5D9" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="SameScreenOptions" Spacing="10" Visibility="Collapsed">
                                    <ToggleSwitch x:Name="SameScreenEnabledSwitch" AutomationProperties.Name="启用同屏竞速"
                                                  OffContent="关闭" OnContent="开启" Toggled="SameScreenEnabled_Toggled" />
                                    <ComboBox x:Name="SameScreenModeBox" Header="任务结束方式" IsEnabled="False" />
                                    <TextBlock Text="同屏竞速死亡后会自行复活，助手等待复活后先跳出危险区；与多人竞速共用同一套 WinML 识别和战斗内核。"
                                               Foreground="#B9C5D9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="两个周末活动按轮换开放，同一时间只运行当前所选的那个。"
                                       Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="家族" FontSize="21" FontWeight="SemiBold" />
                            <SelectorBar x:Name="FamilyTabs" AutomationProperties.Name="家族">
                                <SelectorBarItem x:Name="AbyssTab" Text="深渊备战" />
                            </SelectorBar>
                            <ToggleSwitch x:Name="AbyssEnabledSwitch" AutomationProperties.Name="启用深渊备战"
                                          OffContent="关闭" OnContent="开启" />
                            <TextBlock Text="依次完成三个备战副本的个人进度并领取奖励。"
                                       Foreground="#B9C5D9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="14">
                            <ToggleSwitch x:Name="DailyEnabledSwitch" Header="每日清理" OffContent="关闭" OnContent="开启" Toggled="DailyEnabled_Toggled" />
                            <ContentControl x:Name="DailyOptionsControl" IsEnabled="False" HorizontalContentAlignment="Stretch">
                            <Grid x:Name="DailyOptionsPanel" ColumnSpacing="24" RowSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <CheckBox Content="每月日签到（最多25天）" Tag="monthly" IsChecked="True" />
                                <CheckBox Grid.Row="1" Content="限时签到" Tag="limited" IsChecked="True" />
                                <CheckBox Grid.Row="2" Content="家族免费祈福" Tag="blessing" IsChecked="True" />
                                <CheckBox Grid.Row="3" Content="免费武器抽取" Tag="weapon" IsChecked="True" />
                                <CheckBox Grid.Row="4" Content="免费咒印抽取" Tag="curse" IsChecked="True" />
                                <CheckBox Grid.Column="1" Content="悬赏商店：D、C奖册" Tag="bounty_shop" IsChecked="True" />
                                <CheckBox Grid.Column="1" Grid.Row="1" Content="每日商店：忍币商品" Tag="daily_shop" IsChecked="True" />
                                <CheckBox Grid.Column="1" Grid.Row="2" Content="忍村试炼：从右往左扫荡" Tag="village" IsChecked="True" />
                                <CheckBox Grid.Column="1" Grid.Row="3" Content="小屋：领取碎片并续练" Tag="house" IsChecked="True" />
                                <CheckBox x:Name="BountyTaskOption" Grid.Column="1" Grid.Row="4" Content="每日悬赏清理" Tag="bounty" IsChecked="True"
                                          Checked="BountyTask_Changed" Unchecked="BountyTask_Changed" />
                                <CheckBox x:Name="SBountyTaskOption" Grid.Row="5" Grid.ColumnSpan="2" Content="S级悬赏：清理累计次数（最多7次）" Tag="bounty_s" IsChecked="True"
                                          Checked="BountyTask_Changed" Unchecked="BountyTask_Changed" />
                                <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="忍阶：每日任务与每周道具" Tag="rank" IsChecked="True" />
                                <CheckBox x:Name="PetFeedTaskOption" Grid.Row="7" Content="通灵兽每日喂养" Tag="pet_feed" IsChecked="True"
                                          Checked="PetFeedTask_Changed" Unchecked="PetFeedTask_Changed" />
                                <ComboBox x:Name="PetFeedRewardBox" Grid.Row="7" Grid.Column="1" PlaceholderText="喂养奖励"
                                          AutomationProperties.Name="喂养奖励" SelectedIndex="0" IsEnabled="False">
                                    <ComboBoxItem Content="经验" Tag="exp" />
                                    <ComboBoxItem Content="忍币" Tag="coins" />
                                    <ComboBoxItem Content="强化锤" Tag="hammers" />
                                </ComboBox>
                                <CheckBox Grid.Row="8" Content="竞技场奖励领取" Tag="arena_reward" IsChecked="True" />
                                <CheckBox Grid.Row="8" Grid.Column="1" Content="老板娘答题" Tag="landlady_quiz" IsChecked="True" />
                                <CheckBox Grid.Row="9" Grid.ColumnSpan="2" Content="好友饭团领取与赠送" Tag="friend_rice" />
                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Spacing="6" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="悬赏等级" Foreground="#B9C5D9" />
                                        <TextBlock x:Name="BountyGradeText" Text="D" Foreground="#A5B3FF" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Slider x:Name="BountyGradeSlider" Minimum="0" Maximum="3" Value="0" StepFrequency="1" SmallChange="1"
                                            SnapsTo="StepValues" IsThumbToolTipEnabled="False" ValueChanged="BountyGrade_ValueChanged"
                                            AutomationProperties.Name="悬赏等级 D C B A" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="D" Foreground="#91A1BC" />
                                        <TextBlock Grid.Column="1" Text="C" Foreground="#91A1BC" />
                                        <TextBlock Grid.Column="2" Text="B" Foreground="#91A1BC" />
                                        <TextBlock Grid.Column="2" Text="A" HorizontalAlignment="Right" Foreground="#91A1BC" />
                                    </Grid>
                                    <ContentControl x:Name="BountyInviteOptionsControl" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="BountyActiveInviteOption" IsChecked="True">
                                                <TextBlock Text="主动邀请好友、族员" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox x:Name="BountyPassiveInviteOption" Grid.Column="1" IsChecked="True">
                                                <TextBlock Text="自动接受好友、族员邀请" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </Grid>
                                    </ContentControl>
                                    <TextBlock Text="普通悬赏只清理所选等级，S级单独勾选。地面滑步，绳索保持不动；Boss血条出现后释放忍术并持续攻击。"
                                               TextWrapping="Wrap" Foreground="#91A1BC" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            </ContentControl>
                            <TextBlock Text="先处理每日清理，再做活动日常和上分。仅免费抽取与祈福；商店只用忍币，不付费刷新或购买体力。" TextWrapping="Wrap" Foreground="#B9C5D9" />
                            <TextBlock Text="小屋修炼到时后，在当前任务的安全检查点优先处理。续练消耗5饭团，按倒计时预留。" TextWrapping="Wrap" Foreground="#91A1BC" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="自动助手  /  场景识别" Foreground="#A5B3FF" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="自动识别当前场景" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="逆袭 S：刷新、抢队、准备和结算；隼白战斗：识别攻击后按板子流程躲避。" Foreground="#B9C5D9" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="抢队连点间隔" VerticalAlignment="Center" Foreground="#B9C5D9" />
                                <NumberBox x:Name="JoinIntervalBox" Width="140" Minimum="20" Maximum="1000" Value="30"
                                           SmallChange="10" SpinButtonPlacementMode="Inline" />
                                <TextBlock Text="毫秒" VerticalAlignment="Center" Foreground="#B9C5D9" />
                            </StackPanel>
                            <TextBlock Text="每次点击后立即识别画面；停止任务后可修改。" Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="自动场景  /  隼白" Foreground="#A5B3FF" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="识别到战斗后自动执行" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="正常助手识别到隼白战斗后自动进入躲避流程，无需单独启用或切换。"
                                       Foreground="#B9C5D9" TextWrapping="Wrap" />
                            <TextBlock Text="识别攻击后锁定板子并按流程躲避，支持四连跳、主动下降和翻绳；角色与判定范围仍需实战校准。"
                                       Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="场景调试" Foreground="#A5B3FF" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock x:Name="DebugStatusText" Text="调试仅观察当前场景，输出识别、流程步骤和日志，不发送战斗动作。最长运行 10 分钟。"
                                       Foreground="#D6DDF0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button x:Name="DebugStartButton" Content="场景调试（仅观察）"
                                        Click="DebugStart_Click" Padding="18,9" />
                                <Button x:Name="DebugPauseButton" Content="暂停调试" Click="Pause_Click" IsEnabled="False" Padding="18,9" />
                                <Button x:Name="DebugStopButton" Content="停止调试" Click="Stop_Click" IsEnabled="False" Padding="18,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#151F31" CornerRadius="13" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="识别频率" Foreground="#A7B4CB" FontSize="12" />
                                <TextBlock x:Name="RateText" Text="--" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock Text="次 / 秒" Foreground="#7788A5" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#151F31" CornerRadius="13" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="本次点击" Foreground="#A7B4CB" FontSize="12" />
                                <TextBlock x:Name="ClicksText" Text="0" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock x:Name="ActualIntervalText" Text="最近连点：--" Foreground="#7788A5" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#151F31" CornerRadius="13" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="已确认结算" Foreground="#A7B4CB" FontSize="12" />
                                <TextBlock x:Name="CountText" Text="0" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock Text="当前实例累计" Foreground="#7788A5" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <TextBlock Text="运行记录" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock HorizontalAlignment="Right" Text="场景与调试另存本地记录" Foreground="#8190AB" FontSize="11" />
                    </Grid>
                    <TextBox x:Name="LogBox" Height="145" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" Background="#111A2A" BorderBrush="#27344E"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="MuMu 实例需保持 1280 × 720 横屏。"
                               Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContent" Padding="34,30,34,30" Spacing="20" MaxWidth="850" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="5">
                        <TextBlock Text="设备设置" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="设置 MuMu 安装目录，在任务中心切换实例。" Foreground="#9EACC5" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="MuMu 连接" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="安装目录" Foreground="#B9C5D9" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" PlaceholderText="选择 MuMu 安装目录" />
                                <Button x:Name="FolderButton" Grid.Column="1" Content="选择文件夹" Click="Browse_Click" />
                            </Grid>
                            <TextBlock Text="MuMu 实例" Foreground="#B9C5D9" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsInstanceText" VerticalAlignment="Center" Text="尚未选择实例"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ScanButton" Grid.Column="1" Content="重新扫描" Click="Scan_Click" />
                            </Grid>
                            <TextBlock x:Name="ScanText" Text="等待扫描模拟器。" Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="DeviceText" Text="识别设备：尚未检测" Foreground="#ACBAD1" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="HideGameWindowSwitch" Header="运行时隐藏游戏窗口"
                                          OffContent="保持显示" OnContent="自动隐藏" IsOn="False" />
                            <TextBlock x:Name="ProbeResultText" Foreground="#A5DCC8" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button x:Name="ProbeButton" Content="测试连接" Click="Probe_Click" />
                                <Button x:Name="SaveButton" Content="保存设置" Click="Save_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#172238" BorderBrush="#2D3D5B" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="窗口与托盘" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="最小化后留在托盘，正在运行的任务会继续。双击托盘图标可恢复窗口，右键可退出助手。"
                                       TextWrapping="Wrap" Foreground="#B9C5D9" />
                            <ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭窗口时的默认操作"
                                          OffContent="退出助手" OnContent="最小化到托盘" IsOn="True" Toggled="CloseBehavior_Changed" />
                            <ToggleSwitch x:Name="RememberCloseActionSwitch" Header="记住关闭选择"
                                          OffContent="每次询问" OnContent="不再询问" IsOn="False" Toggled="CloseBehavior_Changed" />
                            <Button Content="恢复每次询问" Click="ResetCloseBehavior_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="测试连接只读取当前画面。请避免让多个助手同时控制同一个模拟器实例。"
                               Foreground="#91A1BC" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
